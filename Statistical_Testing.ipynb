    "    k = min(contingency_table.shape)\n",
    "\n",
    "    cramers_v = (\n",
    "        np.sqrt(chi2 / (n * (k - 1)))\n",
    "        if k > 1 else np.nan\n",
    "    )\n",
    "\n",
    "    chi_results.append({\n",
    "        \"Feature\": col,\n",
    "        \"Chi-Square\": chi2,\n",
    "        \"Degrees of Freedom\": dof,\n",
    "        \"P Value\": p_value,\n",
    "        \"Cramer's V\": cramers_v,\n",
    "        \"Minimum Expected Count\": expected.min(),\n",
    "        \"Significant\": \"Yes\" if p_value < 0.05 else \"No\"\n",
